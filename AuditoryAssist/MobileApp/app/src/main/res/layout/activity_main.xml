<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 상단 앱바 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:title="@string/app_name"
        app:menu="@menu/menu_main_developer" />

    <!-- 본문 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ✅ 홈 화면 연결 상태 표시 카드 -->
            <LinearLayout
                android:id="@+id/cardConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F4F6F8"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvMqttStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MQTT 상태: 확인 중..."
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tvBrokerUri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="브로커: 확인 중..."
                    android:textSize="14sp"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvAlertMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="알림 방식: 확인 중..."
                    android:textSize="14sp"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvLastReceived"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="마지막 수신: 없음"
                    android:textSize="14sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <!-- ✅ 상황 상태 확인 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveSituationStatus"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/menu_situation_status" />

            <!-- 기기 점검 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveCheck"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/go_check" />

            <!-- 로그 확인 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveLog"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:text="@string/go_log" />

            <!-- 설정 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveSetting"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/go_setting" />

            <!-- 실시간 카메라 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveCamera"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/go_camera" />

            <!-- 기기 선택 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveDevice"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:text="@string/go_device" />

            <!-- 푸시 알림 기록 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveNotification"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/go_notification" />

            <!-- MQTT / Wi-Fi 설정 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveWifiSettings"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:text="MQTT / Wi-Fi 설정" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
