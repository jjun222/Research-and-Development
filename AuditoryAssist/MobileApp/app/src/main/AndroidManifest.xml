<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 기본 네트워크 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13 이상 알림 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 로컬 MQTT 백그라운드 알림 서비스용 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 긴급 알림 화면 / 진동용 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InterfaceUI"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 런처 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 긴급 알림 화면 -->
        <activity
            android:name=".ui1.EmergencyAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 실시간 영상 확인 -->
        <activity
            android:name=".ui1.LiveVideoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 기존 CameraActivity는 유지 -->
        <activity
            android:name=".ui1.CameraActivity"
            android:exported="false" />

        <!-- 기존 화면들 -->
        <activity
            android:name=".ui1.SituationStatusActivity"
            android:exported="false" />

        <activity
            android:name=".ui1.DeviceSelectActivity"
            android:exported="false" />

        <activity
            android:name=".ui1.SettingActivity"
            android:exported="false" />

        <activity
            android:name=".ui1.CheckActivity"
            android:exported="false" />

        <activity
            android:name=".ui1.LogActivity"
            android:exported="false" />

        <activity
            android:name=".ui1.NotificationActivity"
            android:exported="false" />

        <activity
            android:name=".ui1.LogHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".WifiSettingsActivity"
            android:exported="false" />

        <!-- FCM 수신 서비스 -->
        <service
            android:name=".service.PushAlertService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 앱 내부 로컬 MQTT 알림 서비스 -->
        <service
            android:name=".service.LocalMqttAlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Paho MQTT 백그라운드 서비스 -->
        <service
            android:name="info.mqtt.android.service.MqttService"
            android:exported="false" />

    </application>
</manifest>
