package com.example.interfaceui.broker

import android.content.Context

object BrokerPrefs {
    private const val PREF_NAME = "broker_prefs"
    private const val KEY_URI = "last_broker_uri"

    const val FALLBACK_URI = "tcp://192.168.0.33:1883"

    fun getBrokerUri(context: Context): String {
        val prefs = context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
        return prefs.getString(KEY_URI, FALLBACK_URI) ?: FALLBACK_URI
    }

    fun saveBrokerUri(context: Context, uri: String) {
        context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
            .edit()
            .putString(KEY_URI, uri)
            .apply()
    }

    fun clear(context: Context) {
        context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
            .edit()
            .remove(KEY_URI)
            .apply()
    }
}
